#include <bits/stdc++.h>
using namespace std;

class Employee {
private:
    int id;
    string name;
    string department;
    double baseSalary;
public:
    Employee() {
        id = 0;
        name = "\0";
        department = "\0";
        baseSalary = 0.0;
    }
    Employee(int empId, string empName) {
        id = empId;
        name = empName;
        department = "\0";
        baseSalary = 0.0;
    }
    Employee(int empId, string empName, string empDepartment,double salary) {
        id = empId;
        name = empName;
        department = empDepartment;
        baseSalary = salary;
    }
    Employee(const Employee &emp) {
        id = emp.id;
        name = emp.name;
        department = emp.department;
        baseSalary = emp.baseSalary;
    }
    double calculatePay() {
        return baseSalary;
    }
    double calculatePay(double bonus) {
        return baseSalary + bonus;
    }
    double calculatePay(double overtimeHours, double hourlyRate) {
        return baseSalary + (overtimeHours * hourlyRate);
    }
    double calculatePay(double bonus, double taxPercentage,bool withTax) {
        double total = baseSalary + bonus;

        if (withTax) {
            double tax = total * taxPercentage / 100;
            return total - tax;
        }

        return total;
    }
    void updateProfile(string newDepartment) {
        department = newDepartment;
    }
    void updateProfile(double newSalary) {
        baseSalary = newSalary;
    }
    void updateProfile(string newDepartment, double newSalary) {
        department = newDepartment;
        baseSalary = newSalary;
    }
    void display() {
        cout << "\nEmployee ID    : " << id << endl;
        cout << "Name           : " << name << endl;
        cout << "Department     : " << department << endl;
        cout << "Base Salary    : " << baseSalary << endl;
    }
};


int main() {
    Employee emp1;
    cout << "Employee 1 - Default Constructor";
    emp1.display();
    Employee emp2(101, "Pooji");
    cout << "\nEmployee 2 - ID and Name Constructor";
    emp2.display();
    Employee emp3(102, "Palak", "IT", 50000);
    cout << "\nEmployee 3 - Full Profile Constructor";
    emp3.display();
    Employee emp4(emp3);
    cout << "\nEmployee 4 - Copy Constructor";
    emp4.display();

    cout << "\ncalculatePay() Demonstration";
    cout << "\n1. Base Salary Only: "<< emp3.calculatePay();
    cout << "\n2. Base Salary + Bonus: "<< emp3.calculatePay(10000);
    cout << "\n3. Base Salary + Overtime: "<< emp3.calculatePay(20, 500);
    cout << "\n4. Base Salary + Bonus - Tax: "<< emp3.calculatePay(10000, 10, true);
    cout << "\nupdateProfile() Demonstration";
    emp3.updateProfile("AI & ML");
    cout << "\n\nAfter updating department:";
    emp3.display();
    emp3.updateProfile(60000);
    cout << "\nAfter updating salary:";
    emp3.display();
    emp3.updateProfile("Software Development", 70000);
    cout << "\nAfter updating department and salary:";
    emp3.display();
    return 0;
}
